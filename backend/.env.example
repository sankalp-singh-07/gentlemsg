# ── Environment ──────────────────────────────────────────
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────
# Local SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./gentlemsg.db

# Neon Postgres (production) — use the async driver:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DB?sslmode=require
# Also accepted: postgresql://... or postgres://... (auto-normalized to +asyncpg)

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES_ACCESS=60
JWT_EXPIRATION_MINUTES_REFRESH=10080

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── URLs ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
# true: public /uploads (fine for local). false: use auth-gated file endpoints only.
SERVE_UPLOADS_PUBLIC=true

# ── Schema ───────────────────────────────────────────────
# true: create_all on startup (dev). false: run `alembic upgrade head` yourself.
AUTO_CREATE_TABLES=true
